{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Gg]it[Hh]ub.*create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hook.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
