{
  "name": "change-impact",
  "version": "0.1.0",
  "type": "module",
  "description": "Run the change-impact-diagram skill automatically on PRs or locally. LLM-agnostic.",
  "bin": {
    "change-impact": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:action": "npx @vercel/ncc build src/action/index.ts -o dist/action --license licenses.txt",
    "build:cli": "npx @vercel/ncc build src/cli/index.ts -o dist/cli --license licenses.txt",
    "build:all": "npm run build:action && npm run build:cli",
    "prepublishOnly": "tsc --noEmit && vitest run && npm run build:all",
    "test": "vitest run"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "impact-analysis",
    "mermaid",
    "llm",
    "anthropic",
    "openai",
    "ollama"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "@clack/prompts": "^0.7.0",
    "openai": "^4.70.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}