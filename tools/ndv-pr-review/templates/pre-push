#!/usr/bin/env bash
# Optional local hook: copy to .git/hooks/pre-push and make it executable.
# Prints an ndv review of what is about to be pushed. It never blocks the push;
# read the summary and decide. Skip it with: NDV_REVIEW=0 git push
[ "${NDV_REVIEW:-1}" = "0" ] && exit 0
command -v claude >/dev/null 2>&1 || exit 0
claude -p "/ndv-pr-review $(git rev-parse --abbrev-ref HEAD)" || true
exit 0
