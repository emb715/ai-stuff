{
  "name": "e2e-web",
  "version": "0.1.0",
  "type": "module",
  "description": "Run a Playwright suite and emit a criteria ledger with runtime evidence anchors. Enforces: a criterion passes only when a test naming it passed.",
  "bin": {
    "e2e-web": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:action": "npx @vercel/ncc build src/action/index.ts -o dist/action --license licenses.txt",
    "build:cli": "npx @vercel/ncc build src/cli/index.ts -o dist/cli --license licenses.txt",
    "build:all": "npm run build:action && npm run build:cli",
    "prepublishOnly": "tsc --noEmit && vitest run && npm run build:all",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "playwright",
    "acceptance-criteria",
    "verification",
    "qa"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
