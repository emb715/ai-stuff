#!/usr/bin/env bash
# commit-msg guardrail: rejects commits whose header is not a Conventional Commit.
# Mirrors the CI check in .github/workflows/commit-lint.yml.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if ! python3 "$REPO_ROOT/scripts/commit_lint.py" --file "$1"; then
    echo ""
    echo "Commit blocked: message header must be 'type(scope): subject'."
    echo "Your message is kept in .git/COMMIT_EDITMSG; fix it and commit again."
    exit 1
fi
